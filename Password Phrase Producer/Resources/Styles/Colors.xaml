<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================================== -->
    <!-- Design System - Unified Color Palette     -->
    <!-- ========================================== -->

    <!-- Primary Brand Colors -->
    <Color x:Key="BrandPrimary">#536D81</Color>
    <Color x:Key="BrandPrimaryDark">#4D697F</Color>
    <Color x:Key="BrandAccent">#A9BBC9</Color>
    <Color x:Key="BrandSuccess">#69C49A</Color>
    <Color x:Key="BrandError">#E88B91</Color>
    <Color x:Key="BrandDanger">#AA4C59</Color>
    <Color x:Key="BrandWarning">#D7AA70</Color>
    <Color x:Key="BrandLink">#A9BBC9</Color>

    <!-- Background Colors -->
    <Color x:Key="BackgroundDark1">#0D1013</Color>
    <Color x:Key="BackgroundDark2">#11161A</Color>
    <Color x:Key="BackgroundDark3">#0F1317</Color>
    <Color x:Key="BackgroundCard">#171C21</Color>
    <Color x:Key="BackgroundCardActive">#1C2329</Color>
    <Color x:Key="BackgroundInput">#20272E</Color>
    <Color x:Key="BackgroundElevated">#2B343D</Color>
    <Color x:Key="BackgroundOverlay">#D90D1013</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#F7F8F9</Color>
    <Color x:Key="TextSecondary">#DDE2E6</Color>
    <Color x:Key="TextTertiary">#9EAAB5</Color>
    <Color x:Key="TextDisabled">#71808C</Color>
    <Color x:Key="TextMuted">#8797A4</Color>
    <Color x:Key="TextPlaceholder">#8797A4</Color>

    <!-- Icon Button Colors -->
    <Color x:Key="IconButtonBackground">#20272E</Color>
    <Color x:Key="IconButtonText">#DDE2E6</Color>
    <Color x:Key="IconButtonDestructive">#392A30</Color>

    <!-- Border/Divider Colors -->
    <Color x:Key="BorderSubtle">#252D34</Color>
    <Color x:Key="BorderDefault">#313B44</Color>

    <!-- Shadow Colors -->
    <Color x:Key="ShadowColor">#25000000</Color>
    <Color x:Key="ShadowColorStrong">#40000000</Color>

    <!-- Legacy Colors (for compatibility) -->
    <Color x:Key="Primary">#536D81</Color>
    <Color x:Key="PrimaryDark">#4D697F</Color>
    <Color x:Key="PrimaryDarkText">#F5F6FA</Color>
    <Color x:Key="Secondary">#A9BBC9</Color>
    <Color x:Key="SecondaryDarkText">#536D81</Color>
    <Color x:Key="Tertiary">#20272E</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#A9BBC9</Color>
    <Color x:Key="MidnightBlue">#0D1013</Color>
    <Color x:Key="OffBlack">#0D1013</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}"/>
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDark}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{StaticResource BackgroundCard}"/>
    <SolidColorBrush x:Key="BackgroundInputBrush" Color="{StaticResource BackgroundInput}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ========================================== -->
    <!-- Design System - Spacing Values            -->
    <!-- ========================================== -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>

    <!-- ========================================== -->
    <!-- Design System - Corner Radius             -->
    <!-- ========================================== -->
    <x:Double x:Key="RadiusSM">3</x:Double>
    <x:Double x:Key="RadiusMD">4</x:Double>
    <x:Double x:Key="RadiusLG">5</x:Double>
    <x:Double x:Key="RadiusXL">6</x:Double>
    <x:Double x:Key="RadiusXXL">8</x:Double>
    <x:Double x:Key="RadiusDialog">8</x:Double>

    <!-- ========================================== -->
    <!-- Design System - Component Sizes           -->
    <!-- ========================================== -->
    <x:Double x:Key="IconButtonSize">40</x:Double>
    <x:Double x:Key="IconButtonSizeLarge">44</x:Double>
    <x:Double x:Key="ButtonHeightDefault">44</x:Double>
    <x:Double x:Key="ButtonHeightCompact">36</x:Double>
    <x:Double x:Key="InputHeight">40</x:Double>

    <!-- ========================================== -->
    <!-- Design System - Typography Sizes          -->
    <!-- ========================================== -->
    <x:Double x:Key="FontSizeHeadline">20</x:Double>
    <x:Double x:Key="FontSizeSubheadline">18</x:Double>
    <x:Double x:Key="FontSizeTitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeTiny">10</x:Double>
    <x:Double x:Key="FontSizeMicro">9</x:Double>

</ResourceDictionary>
