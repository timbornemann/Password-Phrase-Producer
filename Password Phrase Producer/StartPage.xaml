<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Password_Phrase_Producer.StartPage"
             BackgroundColor="{StaticResource BackgroundDark1}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout x:Name="PageContentLayout" Padding="22,20,22,28" Spacing="0">
            <Grid WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" Margin="0,0,0,58">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenMenuTapped" />
                </Grid.GestureRecognizers>
                <Image Source="menu.png" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Start" VerticalOptions="Center" />
            </Grid>

            <Label Text="Sicherheitszentrale" FontSize="29" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" Margin="0,0,0,72" />

            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12"
                      MinimumHeightRequest="86" Padding="0,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToVaultCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="01" FontSize="13" TextColor="{StaticResource TextTertiary}"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Passwort-Tresor" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Passwörter speichern und verwalten" FontSize="12"
                               TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="chevronright.png" WidthRequest="15" HeightRequest="15"
                           Opacity="0.7" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12"
                      MinimumHeightRequest="86" Padding="0,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToDataVaultCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="02" FontSize="13" TextColor="{StaticResource TextTertiary}"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Datentresor" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Notizen, Schlüssel und Zugangsdaten" FontSize="12"
                               TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="chevronright.png" WidthRequest="15" HeightRequest="15"
                           Opacity="0.7" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12"
                      MinimumHeightRequest="86" Padding="0,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToGenerationCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="03" FontSize="13" TextColor="{StaticResource TextTertiary}"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Passwort erstellen" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Neue Passwörter und Phrasen" FontSize="12"
                               TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="chevronright.png" WidthRequest="15" HeightRequest="15"
                           Opacity="0.7" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12"
                      MinimumHeightRequest="86" Padding="0,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAuthenticatorCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="04" FontSize="13" TextColor="{StaticResource TextTertiary}"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Authenticator" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Zwei-Faktor-Codes öffnen" FontSize="12"
                               TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="chevronright.png" WidthRequest="15" HeightRequest="15"
                           Opacity="0.7" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
