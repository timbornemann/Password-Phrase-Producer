<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
             xmlns:controls="clr-namespace:Password_Phrase_Producer.Views.Controls"
             x:Class="Password_Phrase_Producer.Views.AddEntryPage"
             Padding="0"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BackgroundDark1}" Offset="0" />
            <GradientStop Color="{StaticResource BackgroundDark2}" Offset="0.6" />
            <GradientStop Color="{StaticResource BackgroundDark3}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header (Tresor Style) -->
        <Grid Grid.Row="0" Padding="16,16,16,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">

                <!-- Back/Close Button -->
                <Border
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseClicked" />
                    </Border.GestureRecognizers>
                    <Image
                        Source="chevronright.png"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Rotation="180" />
                </Border>

                <Label
                    Grid.Column="1"
                    Text="Neuer 2FA-Eintrag"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />

                <!-- Spacer to keep title centered -->
                <Border
                    Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    Opacity="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0" />
            </Grid>
        </Grid>

        <!-- Segmented Control (Tabs) -->
        <Border Grid.Row="1"
                Margin="16,6,16,16"
                StrokeThickness="0"
                BackgroundColor="{StaticResource BackgroundInput}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, *">
                <Button x:Name="BtnManual" Text="Manuell" Clicked="OnTabClicked"
                        BackgroundColor="{StaticResource BrandPrimary}" TextColor="White" CornerRadius="3" Margin="2" HeightRequest="36" FontSize="12" />
                <Button x:Name="BtnScan" Text="QR Scan" Clicked="OnTabClicked" Grid.Column="1"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}" CornerRadius="3" Margin="2" HeightRequest="36" FontSize="12" />
            </Grid>
        </Border>

        <!-- Use a Grid to stack views and toggle visibility -->
        <Grid Grid.Row="2">
            <!-- Manual Form -->
            <ScrollView x:Name="ManualView" IsVisible="True" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Aussteller (z.B. Google)" TextColor="{StaticResource TextTertiary}" FontSize="11" FontAttributes="Bold" />
                        <controls:FramedEntry x:Name="EntryIssuer" Placeholder="z.B. Google" TextColor="White"
                                              BackgroundColor="{StaticResource BackgroundInput}" PlaceholderColor="{StaticResource TextMuted}"
                                              HeightRequest="44" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Account (z.B. E-Mail)" TextColor="{StaticResource TextTertiary}" FontSize="11" FontAttributes="Bold" />
                        <controls:FramedEntry x:Name="EntryAccount" Placeholder="user@example.com" TextColor="White"
                                              BackgroundColor="{StaticResource BackgroundInput}" PlaceholderColor="{StaticResource TextMuted}"
                                              HeightRequest="44" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Secret (Base32)" TextColor="{StaticResource TextTertiary}" FontSize="11" FontAttributes="Bold" />
                        <controls:FramedEntry x:Name="EntrySecret" Placeholder="JBSWY..." TextColor="White"
                                              BackgroundColor="{StaticResource BackgroundInput}" PlaceholderColor="{StaticResource TextMuted}"
                                              HeightRequest="44" />
                        <Label
                            Text="Hinweis: Leerzeichen/Bindestriche werden automatisch entfernt. Ein otpauth://-Link kann hier ebenfalls eingefügt werden."
                            TextColor="{StaticResource TextDisabled}"
                            FontSize="11" />
                    </VerticalStackLayout>

                    <Button Text="Speichern" Clicked="OnSaveClicked"
                            BackgroundColor="{StaticResource BrandPrimary}" TextColor="White"
                            Margin="0,14,0,0" HeightRequest="40" CornerRadius="4" FontSize="12" FontAttributes="Bold" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Scan View: scans continuously, a detected code is imported automatically -->
            <Grid x:Name="ScanView" IsVisible="False" RowDefinitions="*,Auto">
                <Grid Grid.Row="0" Margin="16,0,16,0">
                    <Border StrokeThickness="0" BackgroundColor="{StaticResource BackgroundDark1}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Grid>
                            <cv:CameraView x:Name="cameraView"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           BarcodeDetected="OnBarcodeDetected"
                                           CamerasLoaded="OnCamerasLoaded" />

                            <!-- Tap to focus -->
                            <BoxView Color="Transparent">
                                <BoxView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCameraTapped" />
                                </BoxView.GestureRecognizers>
                            </BoxView>

                            <!-- Viewfinder corners -->
                            <Grid x:Name="Viewfinder"
                                  WidthRequest="240"
                                  HeightRequest="240"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  InputTransparent="True">
                                <Grid.Resources>
                                    <Style TargetType="BoxView">
                                        <Setter Property="Color" Value="#A9BBC9" />
                                        <Setter Property="CornerRadius" Value="2" />
                                    </Style>
                                </Grid.Resources>
                                <BoxView WidthRequest="40" HeightRequest="4" HorizontalOptions="Start" VerticalOptions="Start" />
                                <BoxView WidthRequest="4" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Start" />
                                <BoxView WidthRequest="40" HeightRequest="4" HorizontalOptions="End" VerticalOptions="Start" />
                                <BoxView WidthRequest="4" HeightRequest="40" HorizontalOptions="End" VerticalOptions="Start" />
                                <BoxView WidthRequest="40" HeightRequest="4" HorizontalOptions="Start" VerticalOptions="End" />
                                <BoxView WidthRequest="4" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="End" />
                                <BoxView WidthRequest="40" HeightRequest="4" HorizontalOptions="End" VerticalOptions="End" />
                                <BoxView WidthRequest="4" HeightRequest="40" HorizontalOptions="End" VerticalOptions="End" />
                            </Grid>

                            <!-- Shown when no camera can be used -->
                            <VerticalStackLayout x:Name="NoCameraPanel"
                                                 IsVisible="False"
                                                 Spacing="6"
                                                 Padding="24"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center">
                                <Label x:Name="NoCameraTitle"
                                       Text="Keine Kamera verfügbar"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Du kannst den QR-Code auch als Bild (z.B. Screenshot) laden oder einen otpauth-Link aus der Zwischenablage einfügen."
                                       TextColor="{StaticResource TextTertiary}"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- Camera controls -->
                            <VerticalStackLayout x:Name="CameraControls"
                                                 IsVisible="False"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Start"
                                                 Margin="10"
                                                 Spacing="8">
                                <Border BackgroundColor="#CC20272E" StrokeThickness="0" Padding="6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Button Text="+"
                                                Clicked="OnZoomInClicked"
                                                BackgroundColor="{StaticResource BorderDefault}"
                                                TextColor="White"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="3"
                                                Padding="0" />
                                        <Label x:Name="ZoomLevelLabel"
                                               Text="1.0x"
                                               TextColor="White"
                                               FontSize="10"
                                               HorizontalOptions="Center" />
                                        <Button Text="-"
                                                Clicked="OnZoomOutClicked"
                                                BackgroundColor="{StaticResource BorderDefault}"
                                                TextColor="White"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="3"
                                                Padding="0" />
                                    </VerticalStackLayout>
                                </Border>

                                <Button x:Name="FlashlightButton"
                                        Text="Licht"
                                        Clicked="OnFlashlightClicked"
                                        BackgroundColor="#CC20272E"
                                        TextColor="{StaticResource TextSecondary}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        WidthRequest="52"
                                        HeightRequest="40"
                                        CornerRadius="5"
                                        Padding="0" />

                                <Button x:Name="SwitchCameraButton"
                                        Text="Kamera"
                                        IsVisible="False"
                                        Clicked="OnSwitchCameraClicked"
                                        BackgroundColor="#CC20272E"
                                        TextColor="{StaticResource TextSecondary}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        WidthRequest="52"
                                        HeightRequest="40"
                                        CornerRadius="5"
                                        Padding="0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status and alternative import sources -->
                <Border Grid.Row="1"
                        Margin="16,12,16,16"
                        Padding="14,12"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="ScanStatusLabel"
                                   Text="Suche nach QR-Code …"
                                   TextColor="White"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label x:Name="ScanHintLabel"
                                   Text="Halte den QR-Code in den Rahmen – er wird automatisch erkannt. Auch Google-Authenticator-Exporte werden unterstützt."
                                   TextColor="{StaticResource TextTertiary}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Progress of a Google export that is split over several QR codes -->
                        <VerticalStackLayout x:Name="BatchPanel" IsVisible="False" Spacing="8">
                            <ProgressBar x:Name="BatchProgress" ProgressColor="{StaticResource BrandPrimary}" />
                            <Label x:Name="BatchLabel"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center" />
                            <Button x:Name="ImportPartialButton"
                                    Text="Bisher gescannte Konten importieren"
                                    Clicked="OnImportPartialClicked"
                                    BackgroundColor="{StaticResource BorderDefault}"
                                    TextColor="White"
                                    FontSize="12"
                                    HeightRequest="38"
                                    CornerRadius="4" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Aus Bild laden"
                                    Clicked="OnPickImageClicked"
                                    BackgroundColor="{StaticResource BrandPrimary}"
                                    TextColor="White"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    CornerRadius="4" />
                            <Button Grid.Column="1"
                                    Text="Link einfügen"
                                    Clicked="OnPasteClicked"
                                    BackgroundColor="{StaticResource BorderDefault}"
                                    TextColor="White"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    CornerRadius="4" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
