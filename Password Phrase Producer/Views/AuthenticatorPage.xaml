<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Password_Phrase_Producer.ViewModels"
             x:Class="Password_Phrase_Producer.Views.AuthenticatorPage"
             Title="Authenticator"
             Padding="0"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BackgroundDark1}" Offset="0" />
            <GradientStop Color="{StaticResource BackgroundDark2}" Offset="0.6" />
            <GradientStop Color="{StaticResource BackgroundDark3}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">
        <!-- Header Area (Tresor Style) -->
        <Grid
            Grid.Row="0"
            Padding="16,16,16,10"
            RowDefinitions="Auto"
            RowSpacing="10">

            <!-- Top Bar: Menu, Title, Add, Back -->
            <Grid
                ColumnDefinitions="Auto,*,Auto,Auto"
                ColumnSpacing="10"
                VerticalOptions="Center">

                <!-- Menu Button -->
                <Border
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenMenuTapped" />
                    </Border.GestureRecognizers>
                    <Image
                        Source="menu.png"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Authenticator" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>

                <!-- Add Button -->
                <Border
                    Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddEntryCommand}" />
                    </Border.GestureRecognizers>
                    <Image
                        Source="plus.png"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <!-- Back Button -->
                <Border
                    Grid.Column="3"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image
                        Source="chevronright.png"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Rotation="180" />
                </Border>
            </Grid>
        </Grid>

        <!-- List -->
        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}"
            RefreshColor="{StaticResource BrandPrimary}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Entries}">
                    <BindableLayout.EmptyView>
                        <VerticalStackLayout
                            Padding="0,0,10,0"
                            Spacing="10"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label
                                    Text="A"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                Text="Keine Einträge"
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource TextSecondary}" />
                            <Label
                                Text="Füge deinen ersten 2FA-Eintrag hinzu."
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource TextTertiary}" />
                            <Button
                                Text="Eintrag hinzufügen"
                                Command="{Binding AddEntryCommand}"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                TextColor="{StaticResource TextSecondary}"
                                BorderColor="{StaticResource BrandPrimary}"
                                BorderWidth="1"
                                CornerRadius="4"
                                HeightRequest="40"
                                Padding="14,6"
                                FontSize="12"
                                Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TotpViewModelItem">
                            <Grid>
                            <Border
                                Padding="12"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource BackgroundCard}" Stroke="{StaticResource BorderDefaultBrush}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCopyFeedbackActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#20272E" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="Stroke" Value="#536D81" />
                                    </DataTrigger>
                                </Border.Triggers>
    
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10" ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AuthenticatorViewModel}}, Path=CopyCodeCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
    
                                    <!-- Details -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                        <Label
                                            Text="{Binding Issuer}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="White" />
                                        <Label
                                            Text="{Binding AccountName}"
                                            FontSize="12"
                                            TextColor="{StaticResource TextTertiary}"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
    
                                    <!-- Action Buttons -->
                                    <HorizontalStackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="6"
                                        VerticalOptions="Start"
                                        HorizontalOptions="End">
                                        <Border
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            BackgroundColor="{StaticResource BorderDefault}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="3" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsCopyFeedbackActive}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#536D81" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AuthenticatorViewModel}}, Path=CopyCodeCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image
                                                Source="copy.png"
                                                WidthRequest="14"
                                                HeightRequest="14"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Border
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            BackgroundColor="{StaticResource IconButtonDestructive}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="3" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AuthenticatorViewModel}}, Path=DeleteEntryCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image
                                                Source="trash.png"
                                                WidthRequest="14"
                                                HeightRequest="14"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </HorizontalStackLayout>
    
                                    <!-- Code -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding Code}"
                                        FontSize="32"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        FontFamily="OpenSansSemibold" />
    
                                    <!-- Progress/Timer -->
                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        WidthRequest="44"
                                        RowDefinitions="Auto,*">
                                        <Label
                                            Grid.Row="0"
                                            Text="{Binding RemainingSeconds}"
                                            HorizontalOptions="Center"
                                            TextColor="{StaticResource TextDisabled}"
                                            FontSize="12"
                                            ZIndex="10"
                                            Margin="0,0,0,2" />
                                        <Border
                                            Grid.Row="1"
                                            VerticalOptions="Center"
                                            HeightRequest="4"
                                            WidthRequest="44"
                                            BackgroundColor="Transparent"
                                            Padding="0">
                                            <ProgressBar
                                                Progress="{Binding Progress}"
                                                ProgressColor="{StaticResource BrandPrimary}"
                                                ScaleY="4"
                                                WidthRequest="44"
                                                BackgroundColor="{StaticResource BorderDefault}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
