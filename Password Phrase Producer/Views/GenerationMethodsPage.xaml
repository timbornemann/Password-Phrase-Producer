<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Password_Phrase_Producer"
             xmlns:vm="clr-namespace:Password_Phrase_Producer.ViewModels"
             x:Class="Password_Phrase_Producer.Views.GenerationMethodsPage"
             Padding="0"
             Shell.NavBarIsVisible="False">
    
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BackgroundDark1}" Offset="0" />
            <GradientStop Color="{StaticResource BackgroundDark2}" Offset="0.6" />
            <GradientStop Color="{StaticResource BackgroundDark3}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10"
              Padding="16,16,16,10">
            
            <!-- Hamburger Menu -->
            <Border WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenMenuTapped" />
                </Border.GestureRecognizers>
                <Image Source="menu.png"
                       WidthRequest="18"
                       HeightRequest="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Methode wählen" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
            
            <!-- Back Button -->
            <Border Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="chevronright.png"
                       WidthRequest="18"
                       HeightRequest="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Rotation="0"/>
            </Border>
        </Grid>

    <ScrollView Grid.Row="1">
        <VerticalStackLayout x:Name="PageContentLayout"
                             Spacing="14"
                             Padding="16,0,16,28">

            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ModeOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:PasswordModeOption">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                              ColumnSpacing="12" MinimumHeightRequest="76" Padding="2,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.NavigateToModeCommand, Source={RelativeSource AncestorType={x:Type local:Views.GenerationMethodsPage}}}"
                                                     CommandParameter="{Binding}"/>
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>
                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextTertiary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="chevronright.png" WidthRequest="13" HeightRequest="13"
                                   Opacity="0.7" VerticalOptions="Center" />
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1"
                                     Color="{StaticResource BorderSubtle}" Margin="0,12,0,0" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
