<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:security="clr-namespace:Password_Phrase_Producer.Views.Security"
             x:Class="Password_Phrase_Producer.Views.Security.AppLoginPage"
             Title="Anmeldung" BackgroundColor="{StaticResource BackgroundDark1}">
    <Grid RowDefinitions="*,Auto,*" Padding="28">
        <VerticalStackLayout Grid.Row="1" MaximumWidthRequest="400"
                             HorizontalOptions="Fill" Spacing="16">
            <Label Text="App entsperren" FontSize="27" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" Margin="0,0,0,18"
                   HorizontalTextAlignment="Center" />

            <security:PasswordInputEntry x:Name="PasswordEntry" Placeholder="App-Passwort"
                                IsPassword="True" ReturnType="Go"
                                Completed="OnPasswordCompleted" HeightRequest="48"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource TextMuted}" />

            <Button x:Name="UnlockButton" Text="Entsperren" Clicked="OnUnlockClicked"
                    BackgroundColor="{StaticResource BrandPrimary}" TextColor="White"
                    HeightRequest="46" />

            <Button x:Name="BiometricButton" Text="Biometrie verwenden"
                    Clicked="OnBiometricClicked" IsVisible="False"
                    BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" />

            <Label x:Name="AttemptStatusLabel" FontSize="12"
                   TextColor="{StaticResource TextTertiary}"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="RecoveryButton" Text="Sicherheitsfragen beantworten"
                    Clicked="OnRecoveryClicked" IsVisible="False"
                    BackgroundColor="Transparent" TextColor="{StaticResource BrandAccent}" />

            <Label x:Name="ErrorLabel" FontSize="12" IsVisible="False"
                   TextColor="{StaticResource BrandError}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
