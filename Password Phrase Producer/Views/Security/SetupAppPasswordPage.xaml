<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Password_Phrase_Producer.Views.Controls"
             xmlns:security="clr-namespace:Password_Phrase_Producer.Views.Security"
             x:Class="Password_Phrase_Producer.Views.Security.SetupAppPasswordPage"
             Title="App-Passwort einrichten"
             BackgroundColor="{StaticResource BackgroundDark1}">
    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="400" HorizontalOptions="Fill"
                             Margin="28,80,28,28" Spacing="16">
            <Label Text="App-Passwort einrichten" FontSize="27" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" Margin="0,0,0,6" />
            <Label Text="Dieses Passwort schützt den Zugriff auf die App."
                   FontSize="13" TextColor="{StaticResource TextTertiary}"
                   Margin="0,0,0,18" />

            <security:PasswordInputEntry x:Name="PasswordEntry" Placeholder="Neues Passwort"
                                IsPassword="True" HeightRequest="48"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource TextMuted}" />
            <controls:PasswordStrengthMeter x:Name="StrengthMeter" />

            <security:PasswordInputEntry x:Name="ConfirmPasswordEntry" Placeholder="Passwort bestätigen"
                                IsPassword="True" HeightRequest="48"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource TextMuted}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,8">
                <Label Text="Biometrie aktivieren" FontSize="13"
                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                <Switch x:Name="BiometricSwitch" Grid.Column="1"
                        VerticalOptions="Center" OnColor="{StaticResource BrandPrimary}" />
            </Grid>

            <Button Text="Einrichten" Clicked="OnSetupClicked" HeightRequest="46"
                    BackgroundColor="{StaticResource BrandPrimary}" TextColor="White" />

            <Label x:Name="ErrorLabel" FontSize="12" IsVisible="False"
                   TextColor="{StaticResource BrandError}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
