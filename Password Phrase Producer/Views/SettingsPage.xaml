<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Password_Phrase_Producer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Password_Phrase_Producer.Converters"
    xmlns:controls="clr-namespace:Password_Phrase_Producer.Views.Controls"
    xmlns:viewmodels="clr-namespace:Password_Phrase_Producer.ViewModels"
    xmlns:views="clr-namespace:Password_Phrase_Producer.Views"
    Padding="0"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotNullOrWhiteSpaceConverter x:Key="StringNotNullOrWhiteSpaceConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BackgroundDark1}" Offset="0" />
            <GradientStop Color="{StaticResource BackgroundDark2}" Offset="0.6" />
            <GradientStop Color="{StaticResource BackgroundDark3}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid
            Padding="16,16,16,10"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10">

            <!-- Hamburger Menu -->
            <Border
                WidthRequest="40"
                HeightRequest="40"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenFlyoutTapped" />
                </Border.GestureRecognizers>
                <Image
                    Source="menu.png"
                    WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Einstellungen" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>

            <!-- Back Button -->
            <Border
                Grid.Column="2"
                WidthRequest="40"
                HeightRequest="40"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image
                    Source="chevronright.png"
                    WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Rotation="0" />
            </Border>
        </Grid>

        <ScrollView x:Name="SettingsScroll" Grid.Row="1">
            <VerticalStackLayout Padding="16,0,16,24" Spacing="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="8" RowSpacing="8" Margin="0,2,0,4">
                    <Button x:Name="SecurityTab" Text="Zugriff" CommandParameter="security"
                            Clicked="OnSettingsCategoryClicked" Grid.Row="0" Grid.Column="0" />
                    <Button x:Name="VaultTab" Text="Tresore" CommandParameter="vaults"
                            Clicked="OnSettingsCategoryClicked" Grid.Row="0" Grid.Column="1" />
                    <Button x:Name="DataTab" Text="Daten" CommandParameter="data"
                            Clicked="OnSettingsCategoryClicked" Grid.Row="1" Grid.Column="0" />
                    <Button x:Name="AppTab" Text="App" CommandParameter="app"
                            Clicked="OnSettingsCategoryClicked" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" />
                <Label x:Name="SettingsSectionTitle" Text="Zugriff &amp; Sicherheit"
                       FontSize="19" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <VerticalStackLayout x:Name="SecuritySettingsSection" Spacing="14" IsVisible="True">
                <Border
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="App-Passwort"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Aktuelles App-Passwort"
                            TextColor="{StaticResource TextTertiary}"
                            FontSize="12">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasAppPassword}" Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Entry
                            Text="{Binding CurrentAppPassword}"
                            Placeholder="Aktuelles App-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding HasAppPassword}" Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>

                        <Entry
                            Text="{Binding NewAppPassword}"
                            Placeholder="Neues App-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />
                        <controls:PasswordStrengthMeter x:DataType="viewmodels:VaultSettingsViewModel"
                                                        Password="{Binding NewAppPassword}" />
                        <Entry
                            Text="{Binding ConfirmAppPassword}"
                            Placeholder="Passwort bestätigen"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />

                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanUseAppBiometric}">
                            <Switch
                                Grid.Column="0"
                                IsToggled="{Binding EnableAppBiometric}" />
                            <Label
                                Grid.Column="1"
                                Text="Biometrische Anmeldung speichern"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}"
                                Margin="10,0,0,0"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap" />
                        </Grid>

                        <Label
                            Text="{Binding ChangeAppPasswordError}"
                            TextColor="{StaticResource BrandError}"
                            FontSize="11"
                            IsVisible="{Binding ChangeAppPasswordError, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />
                        <Label
                            Text="{Binding ChangeAppPasswordSuccess}"
                            TextColor="{StaticResource BrandSuccess}"
                            FontSize="11"
                            IsVisible="{Binding ChangeAppPasswordSuccess, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Button
                                Text="App-Passwort aktualisieren"
                                Command="{Binding ChangeAppPasswordCommand}"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="5"
                                Padding="12,8" />
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="{Binding IsAppPasswordChangeBusy}"
                                IsVisible="{Binding IsAppPasswordChangeBusy}"
                                Color="{StaticResource BrandSuccess}"
                                WidthRequest="24"
                                HeightRequest="24" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource BackgroundCard}" Padding="14" StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sicherheitsfragen" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Notzugang nach einer Sperre. Zum Ändern müssen alle Tresore geöffnet sein."
                               FontSize="12" TextColor="{StaticResource TextTertiary}" />
                        <Button Text="Sicherheitsfragen einrichten oder ändern"
                                Clicked="OnConfigureRecoveryClicked" BackgroundColor="{StaticResource BrandPrimary}" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="VaultSettingsSection" Spacing="14" IsVisible="False">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button x:Name="PasswordVaultTab" Text="Passwort" CommandParameter="password"
                                Clicked="OnVaultCategoryClicked" Grid.Column="0" FontSize="12" />
                        <Button x:Name="DataVaultTab" Text="Daten" CommandParameter="data"
                                Clicked="OnVaultCategoryClicked" Grid.Column="1" FontSize="12" />
                        <Button x:Name="AuthenticatorTab" Text="2FA" CommandParameter="authenticator"
                                Clicked="OnVaultCategoryClicked" Grid.Column="2" FontSize="12" />
                    </Grid>
                <Border x:Name="PasswordVaultSettingsCard" IsVisible="True"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Passwort-Tresor-Passwort"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Entry
                            Text="{Binding CurrentMasterPassword}"
                            Placeholder="Aktuelles Master-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />
                        <Entry
                            Text="{Binding NewMasterPassword}"
                            Placeholder="Neues Master-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />
                        <controls:PasswordStrengthMeter x:DataType="viewmodels:VaultSettingsViewModel"
                                                        Password="{Binding NewMasterPassword}" />
                        <Entry
                            Text="{Binding ConfirmMasterPassword}"
                            Placeholder="Passwort bestätigen"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />

                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanUseBiometric}">
                            <Switch
                                Grid.Column="0"
                                IsToggled="{Binding EnableBiometric}" />
                            <Label
                                Grid.Column="1"
                                Text="Biometrische Anmeldung speichern"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}"
                                Margin="10,0,0,0"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap" />
                        </Grid>

                        <Label
                            Text="{Binding ChangePasswordError}"
                            TextColor="{StaticResource BrandError}"
                            FontSize="11"
                            IsVisible="{Binding ChangePasswordError, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />
                        <Label
                            Text="{Binding ChangePasswordSuccess}"
                            TextColor="{StaticResource BrandSuccess}"
                            FontSize="11"
                            IsVisible="{Binding ChangePasswordSuccess, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Button
                                Text="Passwort aktualisieren"
                                Command="{Binding ChangePasswordCommand}"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="5"
                                Padding="12,8" />
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="{Binding IsPasswordChangeBusy}"
                                IsVisible="{Binding IsPasswordChangeBusy}"
                                Color="{StaticResource BrandSuccess}"
                                WidthRequest="24"
                                HeightRequest="24" />
                        </Grid>

                        <Button
                            Text="Passwort-Tresor zurücksetzen"
                            Clicked="OnResetPasswordVaultClicked"
                            BackgroundColor="{StaticResource BrandDanger}"
                            TextColor="White"
                            FontSize="13"
                            CornerRadius="5"
                            Padding="12,8"
                            Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="DataVaultSettingsCard" IsVisible="False"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Datentresor Master-Passwort"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Entry
                            Text="{Binding CurrentDataVaultMasterPassword}"
                            Placeholder="Aktuelles Master-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />
                        <Entry
                            Text="{Binding NewDataVaultMasterPassword}"
                            Placeholder="Neues Master-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />
                        <controls:PasswordStrengthMeter x:DataType="viewmodels:VaultSettingsViewModel"
                                                        Password="{Binding NewDataVaultMasterPassword}" />
                        <Entry
                            Text="{Binding ConfirmDataVaultMasterPassword}"
                            Placeholder="Passwort bestätigen"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />

                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanUseDataVaultBiometric}">
                            <Switch
                                Grid.Column="0"
                                IsToggled="{Binding EnableDataVaultBiometric}" />
                            <Label
                                Grid.Column="1"
                                Text="Biometrische Anmeldung speichern"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}"
                                Margin="10,0,0,0"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap" />
                        </Grid>

                        <Label
                            Text="{Binding ChangeDataVaultPasswordError}"
                            TextColor="{StaticResource BrandError}"
                            FontSize="11"
                            IsVisible="{Binding ChangeDataVaultPasswordError, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />
                        <Label
                            Text="{Binding ChangeDataVaultPasswordSuccess}"
                            TextColor="{StaticResource BrandSuccess}"
                            FontSize="11"
                            IsVisible="{Binding ChangeDataVaultPasswordSuccess, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Button
                                Text="Passwort aktualisieren"
                                Command="{Binding ChangeDataVaultPasswordCommand}"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="5"
                                Padding="12,8" />
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="{Binding IsDataVaultPasswordChangeBusy}"
                                IsVisible="{Binding IsDataVaultPasswordChangeBusy}"
                                Color="{StaticResource BrandSuccess}"
                                WidthRequest="24"
                                HeightRequest="24" />
                        </Grid>

                        <Button
                            Text="Datentresor zurücksetzen"
                            Clicked="OnResetDataVaultClicked"
                            BackgroundColor="{StaticResource BrandDanger}"
                            TextColor="White"
                            FontSize="13"
                            CornerRadius="5"
                            Padding="12,8"
                            Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="AuthenticatorSettingsCard" IsVisible="False"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Authenticator-Passwort"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Aktuelles Authenticator-Passwort"
                            TextColor="{StaticResource TextTertiary}"
                            FontSize="12">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasAuthenticatorPassword}" Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Entry
                            Text="{Binding CurrentAuthenticatorPassword}"
                            Placeholder="Aktuelles Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding HasAuthenticatorPassword}" Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>

                        <Entry
                            Text="{Binding NewAuthenticatorPassword}"
                            Placeholder="Neues Authenticator-Passwort"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />
                        <controls:PasswordStrengthMeter x:DataType="viewmodels:VaultSettingsViewModel"
                                                        Password="{Binding NewAuthenticatorPassword}" />
                        <Entry
                            Text="{Binding ConfirmAuthenticatorPassword}"
                            Placeholder="Passwort bestätigen"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HasAuthenticatorPassword}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Switch Grid.Column="0" IsToggled="{Binding EnableAuthenticatorBiometric}" />
                                <Label Grid.Column="1"
                                       Text="{Binding AuthenticatorBiometricLabel}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Text="Zum Aktivieren das aktuelle Passwort eingeben."
                                   FontSize="11" TextColor="{StaticResource TextTertiary}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Button Text="Biometrie übernehmen"
                                        Command="{Binding ConfigureAuthenticatorBiometricCommand}"
                                        BackgroundColor="{StaticResource BackgroundInput}"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="5"
                                        Padding="12,8" />
                                <ActivityIndicator Grid.Column="1"
                                                   IsRunning="{Binding IsAuthenticatorBiometricBusy}"
                                                   IsVisible="{Binding IsAuthenticatorBiometricBusy}"
                                                   Color="{StaticResource BrandSuccess}"
                                                   WidthRequest="24"
                                                   HeightRequest="24" />
                            </Grid>
                        </VerticalStackLayout>

                        <Label
                            Text="{Binding ChangeAuthenticatorPasswordError}"
                            TextColor="{StaticResource BrandError}"
                            FontSize="11"
                            IsVisible="{Binding ChangeAuthenticatorPasswordError, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />
                        <Label
                            Text="{Binding ChangeAuthenticatorPasswordSuccess}"
                            TextColor="{StaticResource BrandSuccess}"
                            FontSize="11"
                            IsVisible="{Binding ChangeAuthenticatorPasswordSuccess, Converter={StaticResource StringNotNullOrWhiteSpaceConverter}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Button
                                Text="Authenticator-Passwort aktualisieren"
                                Command="{Binding ChangeAuthenticatorPasswordCommand}"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="5"
                                Padding="12,8" />
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="{Binding IsAuthenticatorPasswordChangeBusy}"
                                IsVisible="{Binding IsAuthenticatorPasswordChangeBusy}"
                                Color="{StaticResource BrandSuccess}"
                                WidthRequest="24"
                                HeightRequest="24" />
                        </Grid>

                        <Button
                            Text="2FA-Tresor zurücksetzen"
                            Clicked="OnResetAuthenticatorClicked"
                            BackgroundColor="{StaticResource BrandDanger}"
                            TextColor="White"
                            FontSize="13"
                            CornerRadius="5"
                            Padding="12,8"
                            Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="DataSettingsSection" Spacing="14" IsVisible="False">
                <Border x:Name="LocalTransferSection"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Lokaler Transfer" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Senden" Clicked="OnLocalSendClicked"
                                BackgroundColor="{StaticResource BrandPrimary}" TextColor="White"
                                CornerRadius="4" Padding="10,8" />
                            <Button Grid.Column="1" Text="Empfangen" Clicked="OnLocalReceiveClicked"
                                BackgroundColor="{StaticResource BackgroundInput}" TextColor="White"
                                CornerRadius="4" Padding="10,8" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Gesamtbackup"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Text="Export und Import aller Tresore. Dafür müssen sie entsperrt sein."
                            FontSize="12"
                            TextColor="{StaticResource TextTertiary}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Text="Alles exportieren"
                                Clicked="OnExportFullBackupClicked"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                TextColor="White"
                                FontSize="11"
                                Padding="8,6"
                                CornerRadius="4" />
                            <Button
                                Grid.Column="1"
                                Text="Alles importieren"
                                Clicked="OnImportFullBackupClicked"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                TextColor="White"
                                FontSize="11"
                                Padding="8,6"
                                CornerRadius="4" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Synchronization Section -->
                <Border
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="14"
                    StrokeThickness="1" Stroke="{StaticResource BorderDefaultBrush}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Synchronisation"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Text="Synchronisation über eine verschlüsselte Datei."
                            FontSize="12"
                            TextColor="{StaticResource TextTertiary}" />

                        <Label
                            Text="Status"
                            FontSize="12"
                            TextColor="{StaticResource TextTertiary}" />
                        <Label
                            Text="{Binding SyncStatusMessage}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{Binding SyncStatusColor}" />

                        <Label
                            Text="Dateipfad"
                            FontSize="12"
                            TextColor="{StaticResource TextTertiary}"
                            Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry
                                Text="{Binding SyncPath}"
                                Placeholder="Pfad zur Sync-Datei"
                                PlaceholderColor="{StaticResource TextMuted}"
                                TextColor="White"
                                BackgroundColor="{StaticResource BackgroundInput}"
                                FontSize="13"
                                HeightRequest="38" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <Button
                                    Text="Neu"
                                    Command="{Binding CreateSyncFileCommand}"
                                    BackgroundColor="{StaticResource BackgroundElevated}"
                                    TextColor="White"
                                    FontSize="11"
                                    Padding="8,0"
                                    HeightRequest="38"
                                    CornerRadius="3" />
                                <Button
                                    Text="..."
                                    Command="{Binding PickSyncFileCommand}"
                                    BackgroundColor="{StaticResource BackgroundElevated}"
                                    TextColor="White"
                                    WidthRequest="40"
                                    HeightRequest="38"
                                    Padding="0"
                                    CornerRadius="3" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Label
                            Text="Sync-Passwort"
                            FontSize="12"
                            TextColor="{StaticResource TextTertiary}" />
                        <Entry
                            Text="{Binding SyncPassword}"
                            Placeholder="Passwort festlegen"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="White"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            IsPassword="True"
                            FontSize="13"
                            HeightRequest="38" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            Margin="0,6,0,2">
                            <Switch
                                IsToggled="{Binding IsSyncReadOnly}"
                                Toggled="OnSyncAccessModeToggled"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    Text="Nur lesen &amp; zusammenführen"
                                    FontSize="12"
                                    TextColor="White"
                                    FontAttributes="Bold" />
                                <Label
                                    Text="Aktiviert: Sync liest nur und schreibt nie in die Datei."
                                    FontSize="11"
                                    TextColor="{StaticResource TextTertiary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Button
                            Text="Synchronisation einrichten"
                            Command="{Binding ConfigureSyncCommand}"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            TextColor="White"
                            FontSize="13"
                            Padding="12,8"
                            CornerRadius="5"
                            Margin="0,8,0,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSyncBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Text" Value="Wird eingerichtet..." />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button
                            Text="Jetzt synchronisieren"
                            Clicked="OnManualSyncClicked"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            TextColor="White"
                            FontSize="13"
                            Padding="12,8"
                            CornerRadius="5"
                            Margin="0,0,0,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSyncBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button
                            Text="Nur laden (kein Upload)"
                            Clicked="OnLoadSyncClicked"
                            BackgroundColor="{StaticResource BackgroundElevated}"
                            TextColor="White"
                            FontSize="13"
                            Padding="12,8"
                            CornerRadius="5"
                            Margin="0,0,0,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSyncBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button
                            Text="Sync-Verbindung löschen"
                            Clicked="OnRemoveSyncClicked"
                            BackgroundColor="{StaticResource BrandDanger}"
                            TextColor="White"
                            FontSize="13"
                            Padding="12,8"
                            CornerRadius="5"
                            Margin="0,8,0,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSyncBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                             <Label Text="Letzte Synchronisation:" FontSize="12" TextColor="{StaticResource TextTertiary}" FontAttributes="Bold"/>
                             <Label Text="{Binding PasswordVaultSyncTime, StringFormat='Passwörter: {0:g}'}" FontSize="11" TextColor="{StaticResource TextMuted}"/>
                             <Label Text="{Binding DataVaultSyncTime, StringFormat='Datentresor: {0:g}'}" FontSize="11" TextColor="{StaticResource TextMuted}"/>
                             <Label Text="{Binding AuthenticatorSyncTime, StringFormat='Authenticator: {0:g}'}" FontSize="11" TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="AppSettingsSection" Spacing="14" IsVisible="False">
                <views:UpdateSettingsView x:Name="UpdatePanel" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
