<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Password_Phrase_Producer.Windows.PasswordGenerationWindows.Controls.PasswordAnalysisPanel">
    <VerticalStackLayout Spacing="10">
        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,6,0,4" />

        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <Label Text="Sicherheitsanalyse"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="ⓘ"
                    Clicked="OnInfoTapped"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalOptions="End" />
        </Grid>

        <Label x:Name="strengthLabel"
               Text="Stärke: -"
               FontSize="13"
               TextColor="{StaticResource TextSecondary}" />
        <ProgressBar x:Name="strengthBar"
                     Progress="0"
                     HeightRequest="6"
                     BackgroundColor="{StaticResource BackgroundInput}"
                     ProgressColor="{StaticResource BrandSuccess}" />

        <Label x:Name="entropyLabel"
               Text="Entropie: -"
               FontSize="12"
               TextColor="{StaticResource TextSecondary}" />
        <Label x:Name="characterSetLabel"
               Text="Zeichenräume: -"
               FontSize="11"
               TextColor="{StaticResource TextTertiary}" />

        <VerticalStackLayout x:Name="suggestionSection" Spacing="4" IsVisible="False">
            <Label Text="Verbesserungstipps"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   FontAttributes="Bold" />
            <Label x:Name="suggestionsLabel"
                   Text="-"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
